PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
NODE_ENV=development

# LDAP/AD Import (optional — import disabled if not set)
LDAP_URL=ldap://dc.example.com
LDAP_BASE_DN=OU=Users,DC=example,DC=com
LDAP_BIND_DN=CN=ldap-reader,DC=example,DC=com
LDAP_BIND_PASSWORD=
LDAP_SYNC_HOUR=3
# Attribute mapping (adjust for your AD schema)
LDAP_ATTR_USERNAME=cn
LDAP_ATTR_DISPLAY_NAME=cn
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_OFFICE=roomNumber
LDAP_ATTR_GUID=entryUUID
LDAP_ATTR_PROPER=description
