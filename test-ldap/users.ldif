# Seed LDIF for osixia/openldap — domain structure auto-created by the image
# Adds OUs and test users with AD-like attributes

dn: ou=Users,dc=example,dc=com
objectClass: organizationalUnit
ou: Users

dn: ou=Disabled,dc=example,dc=com
objectClass: organizationalUnit
ou: Disabled

# Active users
dn: cn=admin.user,ou=Users,dc=example,dc=com
